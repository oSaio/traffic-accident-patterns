// ============================================================
// TRAFFIC ACCIDENT PATTERNS
// Member 5: Decision Tree Model
// Dataset: accidents_clean.csv
// JavaScript / Node.js
// ============================================================

const fs = require("fs");
const path = require("path");
const { DecisionTreeClassifier } = require("ml-cart");

// ============================================================
// 1. LOAD DATASET
// ============================================================

const DATASET_PATH = path.join(__dirname, "accidents_clean.csv");

if (!fs.existsSync(DATASET_PATH)) {
    throw new Error("accidents_clean.csv not found.");
}

function parseCSV(content) {
    const lines = content.trim().split(/\r?\n/);

    function splitLine(line) {
        const result = [];
        let current = "";
        let insideQuotes = false;

        for (let i = 0; i < line.length; i++) {
            const char = line[i];

            if (char === '"') {
                if (insideQuotes && line[i + 1] === '"') {
                    current += '"';
                    i++;
                } else {
                    insideQuotes = !insideQuotes;
                }
            } else if (char === "," && !insideQuotes) {
                result.push(current.trim());
                current = "";
            } else {
                current += char;
            }
        }

        result.push(current.trim());
        return result;
    }

    const headers = splitLine(lines[0]).map(
        h => h.trim().toLowerCase().replace(/\s+/g, "_")
    );

    return lines.slice(1)
        .filter(line => line.trim() !== "")
        .map(line => {
            const values = splitLine(line);
            const row = {};

            headers.forEach((header, index) => {
                row[header] = values[index] ?? "";
            });

            return row;
        });
}

const csvContent = fs.readFileSync(DATASET_PATH, "utf8");
const data = parseCSV(csvContent);

console.log("Dataset loaded successfully.");
console.log("Number of records:", data.length);

// ============================================================
// 2. IDENTIFY TARGET COLUMN
// ============================================================

const targetCandidates = [
    "target_severe",
    "accident_severity",
    "severity",
    "collision_severity"
];

const targetColumn = targetCandidates.find(
    column => data.length > 0 &&
    Object.prototype.hasOwnProperty.call(data[0], column)
);

if (!targetColumn) {
    throw new Error("Target column not found.");
}

console.log("Target column:", targetColumn);

// ============================================================
// 3. PREPARE TARGET
// ============================================================

function prepareTarget(value) {
    const text = String(value).trim().toLowerCase();

    const mapping = {
        "0": 0,
        "1": 1,
        "2": 1,
        "3": 0,
        "fatal": 1,
        "serious": 1,
        "severe": 1,
        "slight": 0,
        "minor": 0,
        "low": 0
    };

    return Object.prototype.hasOwnProperty.call(mapping, text)
        ? mapping[text]
        : null;
}

const cleanedData = data
    .map(row => ({
        row,
        target: prepareTarget(row[targetColumn])
    }))
    .filter(item => item.target !== null);

if (cleanedData.length < 10) {
    throw new Error("Not enough valid records.");
}

const classCounts = [0, 0];

cleanedData.forEach(item => {
    classCounts[item.target]++;
});

if (classCounts[0] < 5 || classCounts[1] < 5) {
    throw new Error("Not enough records in both target classes.");
}

console.log("Target distribution:", classCounts);

// ============================================================
// 4. PREPARE FEATURES
// ============================================================

const excludedColumns = [
    targetColumn,
    "target_severe",
    "accident_severity",
    "severity",
    "collision_severity",
    "number_of_casualties",
    "casualties",
    "casualty_severity",
    "accident_index",
    "accident_id",
    "id"
];

const featureColumns = Object.keys(cleanedData[0].row)
    .filter(column => !excludedColumns.includes(column));

if (featureColumns.length === 0) {
    throw new Error("No feature columns available.");
}

// Convert categorical values to numerical categories.
const categoryMaps = {};

featureColumns.forEach(column => {
    const uniqueValues = [
        ...new Set(
            cleanedData
                .map(item => item.row[column])
                .filter(value => value !== "")
        )
    ];

    const numericValues = uniqueValues.every(
        value => Number.isFinite(Number(value))
    );

    if (!numericValues) {
        categoryMaps[column] = new Map(
            uniqueValues.map((value, index) => [value, index])
        );
    }
});

const X = cleanedData.map(item => {
    return featureColumns.map(column => {
        const value = item.row[column];

        if (value === "") {
            return 0;
        }

        if (categoryMaps[column]) {
            return categoryMaps[column].get(value) ?? 0;
        }

        const numericValue = Number(value);

        return Number.isFinite(numericValue)
            ? numericValue
            : 0;
    });
});

const y = cleanedData.map(item => item.target);

console.log("Number of features:", featureColumns.length);

// ============================================================
// 5. TRAIN / TEST SPLIT
// ============================================================

const indices = X.map((_, index) => index);

for (let i = indices.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [indices[i], indices[j]] = [indices[j], indices[i]];
}

const splitIndex = Math.floor(indices.length * 0.8);

const trainIndices = indices.slice(0, splitIndex);
const testIndices = indices.slice(splitIndex);

const XTrain = trainIndices.map(i => X[i]);
const yTrain = trainIndices.map(i => y[i]);

const XTest = testIndices.map(i => X[i]);
const yTest = testIndices.map(i => y[i]);

// ============================================================
// 6. TRAIN DECISION TREE
// ============================================================

const classifier = new DecisionTreeClassifier({
    gainFunction: "gini",
    maxDepth: 6,
    minNumSamples: 5
});

classifier.train(XTrain, yTrain);

console.log("Decision Tree trained successfully.");

// ============================================================
// 7. PREDICTIONS
// ============================================================

const predictions = classifier.predict(XTest);

// ============================================================
// 8. EVALUATION METRICS
// ============================================================

let correct = 0;
let tp = 0;
let tn = 0;
let fp = 0;
let fn = 0;

for (let i = 0; i < yTest.length; i++) {
    if (predictions[i] === yTest[i]) correct++;

    if (predictions[i] === 1 && yTest[i] === 1) tp++;
    if (predictions[i] === 0 && yTest[i] === 0) tn++;
    if (predictions[i] === 1 && yTest[i] === 0) fp++;
    if (predictions[i] === 0 && yTest[i] === 1) fn++;
}

const accuracy = correct / yTest.length;
const precision = tp + fp === 0 ? 0 : tp / (tp + fp);
const recall = tp + fn === 0 ? 0 : tp / (tp + fn);

const f1 = precision + recall === 0
    ? 0
    : 2 * precision * recall / (precision + recall);

console.log("\nMODEL PERFORMANCE");
console.log("----------------------------");
console.log("Accuracy:", accuracy.toFixed(4));
console.log("Precision:", precision.toFixed(4));
console.log("Recall:", recall.toFixed(4));
console.log("F1 Score:", f1.toFixed(4));

// ============================================================
// 9. CONFUSION MATRIX
// ============================================================

const confusionMatrix = [
    [tn, fp],
    [fn, tp]
];

console.log("\nCONFUSION MATRIX");
console.table(confusionMatrix);

// ============================================================
// 10. CLASSIFICATION REPORT
// ============================================================

console.log("\nCLASSIFICATION REPORT");

console.log("Class 0 - Slight");
console.log("Class 1 - Severe/Fatal");

console.log("Class 0 Precision:",
    (tn + fn) === 0 ? 0 : (tn / (tn + fn)).toFixed(4));

console.log("Class 0 Recall:",
    (tn + fp) === 0 ? 0 : (tn / (tn + fp)).toFixed(4));

console.log("Class 1 Precision:", precision.toFixed(4));
console.log("Class 1 Recall:", recall.toFixed(4));

// ============================================================
// 11. SAVE RESULTS
// ============================================================

const outputDirectory = path.join(__dirname, "report");

if (!fs.existsSync(outputDirectory)) {
    fs.mkdirSync(outputDirectory);
}

const metricsCSV = [
    "Metric,Value",
    `Accuracy,${accuracy}`,
    `Precision,${precision}`,
    `Recall,${recall}`,
    `F1 Score,${f1}`
].join("\n");

fs.writeFileSync(
    path.join(outputDirectory, "model_metrics.csv"),
    metricsCSV
);

const predictionsCSV = [
    "Actual,Predicted",
    ...yTest.map((value, index) =>
        `${value},${predictions[index]}`
    )
].join("\n");

fs.writeFileSync(
    path.join(outputDirectory, "predictions.csv"),
    predictionsCSV
);

const matrixCSV = [
    "Actual/Predicted,Slight,Severe/Fatal",
    `Slight,${tn},${fp}`,
    `Severe/Fatal,${fn},${tp}`
].join("\n");

fs.writeFileSync(
    path.join(outputDirectory, "confusion_matrix.csv"),
    matrixCSV
);

console.log("\nGenerated files:");
console.log("report/model_metrics.csv");
console.log("report/predictions.csv");
console.log("report/confusion_matrix.csv");

console.log("\nDECISION TREE MODEL COMPLETED.");
