# ============================================================
# TRAFFIC ACCIDENT PATTERNS
# Member 5: Decision Tree Model
# Dataset: accidents_clean.csv
# ============================================================

from pathlib import Path
import warnings

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.base import clone
from sklearn.model_selection import train_test_split
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OneHotEncoder
from sklearn.impute import SimpleImputer
from sklearn.tree import DecisionTreeClassifier, plot_tree
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix,
    classification_report
)

warnings.filterwarnings("ignore")

# ============================================================
# 1. PATHS AND SETTINGS
# ============================================================

BASE_DIR = Path(__file__).resolve().parent

DATASET_PATH = BASE_DIR / "accidents_clean.csv"

FIGURES_DIR = BASE_DIR / "figures"
REPORT_DIR = BASE_DIR / "report"

FIGURES_DIR.mkdir(exist_ok=True)
REPORT_DIR.mkdir(exist_ok=True)

RANDOM_STATE = 42

# ============================================================
# 2. LOAD DATA
# ============================================================

if not DATASET_PATH.exists():
    raise FileNotFoundError(
        "accidents_clean.csv was not found. "
        "Place it in the same folder as this Python file."
    )

df = pd.read_csv(DATASET_PATH)

df.columns = (
    df.columns.astype(str)
    .str.strip()
    .str.lower()
    .str.replace(" ", "_", regex=False)
)

df = df.drop_duplicates()
df = df.replace([np.inf, -np.inf], np.nan)

print("Dataset loaded successfully.")
print("Dataset shape:", df.shape)
print("Columns:", df.columns.tolist())

# ============================================================
# 3. IDENTIFY TARGET COLUMN
# ============================================================

target_candidates = [
    "target_severe",
    "accident_severity",
    "severity",
    "collision_severity"
]

target_col = next(
    (col for col in target_candidates if col in df.columns),
    None
)

if target_col is None:
    raise ValueError(
        "Target column not found. Expected one of: "
        + ", ".join(target_candidates)
    )

print("\nTarget column:", target_col)

# ============================================================
# 4. PREPARE TARGET
# ============================================================

def prepare_target(series):

    numeric_values = pd.to_numeric(
        series,
        errors="coerce"
    )

    unique_values = set(numeric_values.dropna().unique())

    if unique_values.issubset({0, 1}):
        return numeric_values

    if unique_values.issubset({1, 2, 3}):
        return numeric_values.map({
            1: 1,
            2: 1,
            3: 0
        })

    text_values = (
        series.astype(str)
        .str.strip()
        .str.lower()
    )

    mapping = {
        "0": 0,
        "1": 1,
        "2": 1,
        "3": 0,
        "fatal": 1,
        "serious": 1,
        "severe": 1,
        "slight": 0,
        "minor": 0,
        "low": 0
    }

    result = text_values.map(mapping)

    return result


y = prepare_target(df[target_col])

valid_rows = y.notna()

df = df.loc[valid_rows].copy()
y = y.loc[valid_rows].astype(int)

if y.nunique() != 2:
    raise ValueError(
        "The target must contain both classes: 0 and 1. "
        "Check the target column values."
    )

class_counts = y.value_counts()

if class_counts.min() < 5:
    raise ValueError(
        "There are not enough samples in one target class "
        "for a reliable train/test split."
    )

print("\nTarget distribution:")
print(y.value_counts())

# ============================================================
# 5. PREPARE FEATURES
# ============================================================

columns_to_remove = [
    "target_severe",
    "accident_severity",
    "severity",
    "collision_severity",
    "number_of_casualties",
    "casualties",
    "casualty_severity",
    "accident_index",
    "accident_id",
    "id"
]

X = df.drop(
    columns=[
        col for col in columns_to_remove
        if col in df.columns
    ],
    errors="ignore"
)

# Remove columns containing only missing values
X = X.dropna(axis=1, how="all")

# Extract date features
for col in list(X.columns):

    if "date" in col:
        date_values = pd.to_datetime(
            X[col],
            errors="coerce"
        )

        if date_values.notna().any():

            X[col + "_year"] = date_values.dt.year
            X[col + "_month"] = date_values.dt.month
            X[col + "_day"] = date_values.dt.day
            X[col + "_weekday"] = date_values.dt.dayofweek

            X = X.drop(columns=[col])

if X.shape[1] == 0:
    raise ValueError("No usable feature columns were found.")

# Identify column types
numerical_columns = X.select_dtypes(
    include=["number", "bool"]
).columns.tolist()

categorical_columns = [
    col for col in X.columns
    if col not in numerical_columns
]

# Convert boolean columns to numeric
for col in numerical_columns:
    X[col] = X[col].astype(float)

print("\nNumerical features:", numerical_columns)
print("\nCategorical features:", categorical_columns)

# ============================================================
# 6. PREPROCESSING
# ============================================================

numerical_pipeline = Pipeline([
    ("imputer", SimpleImputer(strategy="median"))
])

categorical_pipeline = Pipeline([
    ("imputer", SimpleImputer(strategy="most_frequent")),
    ("encoder", OneHotEncoder(handle_unknown="ignore"))
])

preprocessor = ColumnTransformer([
    ("numerical", numerical_pipeline, numerical_columns),
    ("categorical", categorical_pipeline, categorical_columns)
])

# ============================================================
# 7. TRAIN / VALIDATION / TEST SPLIT
# ============================================================

X_train_full, X_test, y_train_full, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=RANDOM_STATE,
    stratify=y
)

X_train, X_validation, y_train, y_validation = train_test_split(
    X_train_full,
    y_train_full,
    test_size=0.20,
    random_state=RANDOM_STATE,
    stratify=y_train_full
)

print("\nTraining samples:", len(X_train))
print("Validation samples:", len(X_validation))
print("Testing samples:", len(X_test))

# ============================================================
# 8. MAX DEPTH TUNING
# ============================================================

depth_values = [2, 3, 4, 5, 6, 8, 10]

tuning_results = []

for depth in depth_values:

    model = Pipeline([
        ("preprocessor", clone(preprocessor)),
        ("classifier", DecisionTreeClassifier(
            max_depth=depth,
            random_state=RANDOM_STATE,
            class_weight="balanced"
        ))
    ])

    model.fit(X_train, y_train)

    validation_predictions = model.predict(X_validation)

    accuracy = accuracy_score(
        y_validation,
        validation_predictions
    )

    f1 = f1_score(
        y_validation,
        validation_predictions,
        zero_division=0
    )

    tuning_results.append({
        "max_depth": depth,
        "accuracy": accuracy,
        "f1_score": f1
    })

tuning_df = pd.DataFrame(tuning_results)

tuning_df.to_csv(
    REPORT_DIR / "tuning_results.csv",
    index=False
)

best_depth = int(
    tuning_df.loc[
        tuning_df["f1_score"].idxmax(),
        "max_depth"
    ]
)

print("\nTuning results:")
print(tuning_df)

print("\nBest max_depth:", best_depth)

# ============================================================
# 9. TRAIN FINAL MODEL
# ============================================================

final_model = Pipeline([
    ("preprocessor", clone(preprocessor)),
    ("classifier", DecisionTreeClassifier(
        max_depth=best_depth,
        random_state=RANDOM_STATE,
        class_weight="balanced"
    ))
])

final_model.fit(X_train_full, y_train_full)

# Test only after model selection
y_pred = final_model.predict(X_test)

# ============================================================
# 10. EVALUATION
# ============================================================

accuracy = accuracy_score(y_test, y_pred)

precision = precision_score(
    y_test,
    y_pred,
    zero_division=0
)

recall = recall_score(
    y_test,
    y_pred,
    zero_division=0
)

f1 = f1_score(
    y_test,
    y_pred,
    zero_division=0
)

metrics_df = pd.DataFrame({
    "Metric": [
        "Accuracy",
        "Precision",
        "Recall",
        "F1 Score"
    ],
    "Value": [
        accuracy,
        precision,
        recall,
        f1
    ]
})

metrics_df.to_csv(
    REPORT_DIR / "model_metrics.csv",
    index=False
)

print("\nModel metrics:")
print(metrics_df)

report = classification_report(
    y_test,
    y_pred,
    zero_division=0
)

print("\nClassification Report:")
print(report)

with open(
    REPORT_DIR / "classification_report.txt",
    "w",
    encoding="utf-8"
) as file:
    file.write(report)

# ============================================================
# 11. CONFUSION MATRIX
# ============================================================

cm = confusion_matrix(y_test, y_pred)

plt.figure(figsize=(7, 5))

plt.imshow(cm, cmap="Blues")
plt.title("Decision Tree - Confusion Matrix")
plt.xlabel("Predicted Label")
plt.ylabel("Actual Label")

plt.xticks([0, 1], ["Slight", "Severe/Fatal"])
plt.yticks([0, 1], ["Slight", "Severe/Fatal"])

for i in range(2):
    for j in range(2):
        plt.text(
            j,
            i,
            str(cm[i, j]),
            ha="center",
            va="center",
            color="black",
            fontsize=12
        )

plt.colorbar()
plt.tight_layout()

plt.savefig(
    FIGURES_DIR / "confusion_matrix.png",
    dpi=300
)

plt.close()

# ============================================================
# 12. FEATURE IMPORTANCE
# ============================================================

trained_preprocessor = final_model.named_steps["preprocessor"]
trained_classifier = final_model.named_steps["classifier"]

feature_names = trained_preprocessor.get_feature_names_out()

importance_df = pd.DataFrame({
    "Feature": feature_names,
    "Importance": trained_classifier.feature_importances_
})

importance_df = importance_df.sort_values(
    by="Importance",
    ascending=False
)

importance_df.to_csv(
    REPORT_DIR / "feature_importance.csv",
    index=False
)

top_features = importance_df.head(15)

plt.figure(figsize=(10, 7))

plt.barh(
    top_features["Feature"][::-1],
    top_features["Importance"][::-1]
)

plt.title("Top 15 Important Features")
plt.xlabel("Importance")
plt.ylabel("Feature")
plt.tight_layout()

plt.savefig(
    FIGURES_DIR / "feature_importance.png",
    dpi=300
)

plt.close()

# ============================================================
# 13. MAX DEPTH COMPARISON
# ============================================================

plt.figure(figsize=(8, 5))

plt.plot(
    tuning_df["max_depth"],
    tuning_df["accuracy"],
    marker="o",
    label="Accuracy"
)

plt.plot(
    tuning_df["max_depth"],
    tuning_df["f1_score"],
    marker="o",
    label="F1 Score"
)

plt.title("Max Depth Comparison")
plt.xlabel("Max Depth")
plt.ylabel("Score")
plt.xticks(depth_values)
plt.legend()
plt.grid(True)
plt.tight_layout()

plt.savefig(
    FIGURES_DIR / "max_depth_comparison.png",
    dpi=300
)

plt.close()

# ============================================================
# 14. DECISION TREE VISUALIZATION
# ============================================================

plt.figure(figsize=(22, 12))

plot_tree(
    trained_classifier,
    feature_names=feature_names,
    class_names=["Slight", "Severe/Fatal"],
    filled=True,
    rounded=True,
    max_depth=3,
    fontsize=8
)

plt.title("Decision Tree Visualization")
plt.tight_layout()

plt.savefig(
    FIGURES_DIR / "decision_tree.png",
    dpi=300
)

plt.close()

# ============================================================
# 15. SAVE PREDICTIONS
# ============================================================

predictions_df = pd.DataFrame({
    "Actual": y_test.to_numpy(),
    "Predicted": y_pred
})

predictions_df.to_csv(
    REPORT_DIR / "predictions.csv",
    index=False
)

# ============================================================
# 16. MARKDOWN REPORT
# ============================================================

top_features_text = "\n".join(
    f"- {row.Feature}: {row.Importance:.4f}"
    for row in top_features.itertuples()
)

report_text = f"""
# Traffic Accident Patterns
