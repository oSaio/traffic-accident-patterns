# ============================================================
# TRAFFIC ACCIDENT PATTERNS
# MEMBER 5: DECISION TREE MODEL
# DATASET: accidents_clean.csv (2025)
# ============================================================

import os
import glob
import warnings
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from pathlib import Path
from sklearn.model_selection import train_test_split
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OneHotEncoder
from sklearn.impute import SimpleImputer
from sklearn.tree import DecisionTreeClassifier, plot_tree
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix,
    classification_report
)

warnings.filterwarnings("ignore")

# ============================================================
# 1. SETTINGS
# ============================================================

RANDOM_STATE = 42
np.random.seed(RANDOM_STATE)

os.makedirs("figures", exist_ok=True)
os.makedirs("report", exist_ok=True)

print("=" * 60)
print("TRAFFIC ACCIDENT PATTERNS")
print("MEMBER 5 - DECISION TREE MODEL")
print("=" * 60)

# ============================================================
# 2. LOAD 2025 CLEAN DATASET
# ============================================================

file_path = Path("/content/accidents_clean.csv")

if not file_path.exists():
    matches = glob.glob("**/accidents_clean.csv", recursive=True)
    if matches:
        file_path = Path(matches[0])

if not file_path.exists():
    try:
        from google.colab import files

        print("Upload accidents_clean.csv")
        uploaded = files.upload()

        csv_files = [
            name for name in uploaded
            if name.lower().endswith(".csv")
        ]

        if not csv_files:
            raise FileNotFoundError("No CSV file uploaded.")

        file_path = Path(csv_files[0])

    except ImportError:
        raise FileNotFoundError(
            "Please place accidents_clean.csv in the notebook folder."
        )

df = pd.read_csv(file_path, low_memory=False)
df.columns = df.columns.str.strip()

print("\nDataset loaded successfully!")
print("Dataset:", file_path.name)
print("Dataset shape:", df.shape)

print("\nFirst five rows:")
print(df.head())

# ============================================================
# 3. IDENTIFY TARGET VARIABLE
# ============================================================

target_col = next(
    (c for c in ["target_severe", "Target_Severe"]
     if c in df.columns),
    None
)

severity_col = next(
    (c for c in [
        "accident_severity",
        "collision_severity",
        "severity",
        "Accident_Severity"
    ] if c in df.columns),
    None
)

if target_col is not None:

    values = df[target_col]

    numeric_values = pd.to_numeric(values, errors="coerce")

    if numeric_values.notna().all() and set(
        numeric_values.unique()
    ).issubset({0, 1}):

        y = numeric_values.astype(int)

    else:
        labels = values.astype(str).str.lower().str.strip()

        severity_mapping = {
            "0": 0,
            "1": 1,
            "slight": 0,
            "minor": 0,
            "slight injury": 0,
            "severe": 1,
            "serious": 1,
            "fatal": 1,
            "serious injury": 1,
            "severe/fatal": 1
        }

        y = labels.map(severity_mapping)

elif severity_col is not None:

    values = df[severity_col]
    numeric_values = pd.to_numeric(values, errors="coerce")

    if numeric_values.notna().all():

        unique_values = set(numeric_values.unique())

        if unique_values.issubset({0, 1}):
            y = numeric_values.astype(int)

        elif unique_values.issubset({1, 2, 3}):
            y = numeric_values.map({
                1: 1,
                2: 1,
                3: 0
            })

        else:
            raise ValueError(
                "Unknown numerical severity coding. "
                "Check the severity values."
            )

    else:

        labels = values.astype(str).str.lower().str.strip()

        severity_mapping = {
            "slight": 0,
            "minor": 0,
            "slight injury": 0,
            "fatal": 1,
            "serious": 1,
            "severe": 1,
            "serious injury": 1,
            "severe/fatal": 1
        }

        y = labels.map(severity_mapping)

else:

    raise ValueError(
        "Target column not found. "
        "Check target_severe or accident_severity."
    )

# Remove rows with missing target values
valid = y.notna()

df = df.loc[valid].copy()
y = y.loc[valid].astype(int)

if y.nunique() != 2:
    raise ValueError(
        "Target must contain two classes: "
        "0 = Slight, 1 = Severe/Fatal."
    )

if y.value_counts().min() < 4:
    raise ValueError(
        "Not enough examples in one target class for "
        "the training and validation splits."
    )

print("\nTarget distribution:")
print(y.value_counts())

print("\nTarget distribution (%):")
print((y.value_counts(normalize=True) * 100).round(2))

# ============================================================
# 4. FEATURE ENGINEERING AND CLEANING
# ============================================================

# Extract month, weekday and hour if date/time exist

for col in list(df.columns):

    col_lower = col.lower()

    if col_lower == "date":

        parsed = pd.to_datetime(
            df[col],
            errors="coerce",
            dayfirst=True
        )

        if parsed.notna().sum() > 0:
            df["month"] = parsed.dt.month
            df["weekday"] = parsed.dt.dayofweek

        df.drop(columns=[col], inplace=True)

    elif col_lower == "time":

        parsed = pd.to_datetime(
            df[col].astype(str),
            format="%H:%M",
            errors="coerce"
        )

        if parsed.notna().sum() > 0:
            df["hour"] = parsed.dt.hour

        df.drop(columns=[col], inplace=True)

# Remove target, identifiers and leakage columns

excluded_words = [
    "accident_index",
    "collision_index",
    "accident_id",
    "collision_id",
    "target_severe",
    "accident_severity",
    "collision_severity",
    "severity",
    "number_of_casualties",
    "casualties"
]

drop_cols = [
    c for c in df.columns
    if c.lower() in excluded_words
    or c.lower().endswith("_id")
]

X_raw = df.drop(
    columns=drop_cols,
    errors="ignore"
)

X_raw = X_raw.loc[
    :, ~X_raw.columns.duplicated()
]

X_raw = X_raw.dropna(
    axis=1,
    how="all"
)

if X_raw.shape[1] == 0:
    raise ValueError("No usable feature columns found.")

print("\nNumber of features:", X_raw.shape[1])
print("\nSelected features:")
print(X_raw.columns.tolist())

# ============================================================
# 5. PREPROCESSING AND ONE-HOT ENCODING
# ============================================================

numeric_cols = X_raw.select_dtypes(
    include=["number", "bool"]
).columns.tolist()

categorical_cols = [
    c for c in X_raw.columns
    if c not in numeric_cols
]

# Treat common coded accident categories as categorical
known_categorical = {
    "weekday",
    "day_of_week",
    "road_type",
    "light_conditions",
    "weather_conditions",
    "road_surface_conditions",
    "urban_or_rural_area",
    "junction_detail",
    "junction_control",
    "pedestrian_crossing",
    "special_conditions_at_site",
    "carriageway_hazards",
    "did_police_officer_attend_scene_of_accident"
}

for col in list(numeric_cols):
    if col.lower() in known_categorical:
        numeric_cols.remove(col)
        categorical_cols.append(col)

try:
    encoder = OneHotEncoder(
        handle_unknown="ignore",
        sparse_output=True
    )

except TypeError:

    encoder = OneHotEncoder(
        handle_unknown="ignore",
        sparse=True
    )

numeric_pipeline = Pipeline([
    (
        "imputer",
        SimpleImputer(strategy="median")
    )
])

categorical_pipeline = Pipeline([
    (
        "imputer",
        SimpleImputer(strategy="most_frequent")
    ),
    (
        "encoder",
        encoder
    )
])

transformers = []

if numeric_cols:
    transformers.append(
        ("numeric", numeric_pipeline, numeric_cols)
    )

if categorical_cols:
    transformers.append(
        ("categorical", categorical_pipeline, categorical_cols)
    )

preprocessor = ColumnTransformer(
    transformers=transformers
)

# ============================================================
# 6. TRAIN-TEST SPLIT
# ============================================================

X_train, X_test, y_train, y_test = train_test_split(
    X_raw,
    y,
    test_size=0.20,
    stratify=y,
    random_state=RANDOM_STATE
)

print("\nTraining samples:", len(X_train))
print("Testing samples:", len(X_test))

# ============================================================
# 7. HYPERPARAMETER TUNING
# ============================================================

X_tr, X_val, y_tr, y_val = train_test_split(
    X_train,
    y_train,
    test_size=0.25,
    stratify=y_train,
    random_state=RANDOM_STATE
)

depths = [2, 3, 4, 5, 6, 8, 10]

results = []

print("\nStarting Hyperparameter Tuning...")

for depth in depths:

    model = Pipeline([
        ("preprocessor", preprocessor),

        ("classifier", DecisionTreeClassifier(
            max_depth=depth,
            class_weight="balanced",
            random_state=RANDOM_STATE
        ))
    ])

    model.fit(X_tr, y_tr)

    train_pred = model.predict(X_tr)
    val_pred = model.predict(X_val)

    results.append({

        "max_depth": depth,

        "Train_F1": f1_score(
            y_tr,
            train_pred,
            zero_division=0
        ),

        "Val_F1": f1_score(
            y_val,
            val_pred,
            zero_division=0
        ),

        "Val_Recall": recall_score(
            y_val,
            val_pred,
            zero_division=0
        ),

        "Val_Precision": precision_score(
            y_val,
            val_pred,
            zero_division=0
        )

    })

tuning_df = pd.DataFrame(results)

best_depth = int(
    tuning_df.loc[
        tuning_df["Val_F1"].idxmax(),
        "max_depth"
    ]
)

print("\nTUNING RESULTS:")
print(tuning_df.round(4).to_string(index=False))

print("\nBest Maximum Depth:", best_depth)

tuning_df.to_csv(
    "figures/decision_tree_tuning.csv",
    index=False
)

# Tuning chart

plt.figure(figsize=(8, 5))

plt.plot(
    tuning_df["max_depth"],
    tuning_df["Train_F1"],
    marker="o",
    label="Training F1"
)

plt.plot(
    tuning_df["max_depth"],
    tuning_df["Val_F1"],
    marker="s",
    label="Validation F1"
)

plt.xlabel("Maximum Tree Depth")
plt.ylabel("F1 Score")
plt.title("Decision Tree Hyperparameter Tuning")

plt.legend()
plt.grid(alpha=0.3)
plt.tight_layout()

plt.savefig(
    "figures/tuning_comparison.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()
plt.close()

# ============================================================
# 8. TRAIN FINAL DECISION TREE
# ============================================================

final_dt = Pipeline([
    ("preprocessor", preprocessor),

    ("classifier", DecisionTreeClassifier(
        max_depth=best_depth,
        class_weight="balanced",
        random_state=RANDOM_STATE
    ))
])

final_dt.fit(X_train, y_train)

y_pred = final_dt.predict(X_test)

print("\nFinal Decision Tree model trained successfully!")

# ============================================================
# 9. MODEL EVALUATION
# ============================================================

metrics = {

    "Accuracy": accuracy_score(
        y_test, y_pred
    ),

    "Precision": precision_score(
        y_test, y_pred, zero_division=0
    ),

    "Recall": recall_score(
        y_test, y_pred, zero_division=0
    ),

    "F1-Score": f1_score(
        y_test, y_pred, zero_division=0
    )

}

baseline_acc = (y_test == 0).mean()

metrics_df = pd.DataFrame(
    list(metrics.items()),
    columns=["Metric", "Score"]
)

metrics_df.loc[len(metrics_df)] = [
    "Baseline Accuracy",
    baseline_acc
]

print("\nFINAL MODEL EVALUATION:")
print(metrics_df.round(4).to_string(index=False))

class_report = classification_report(
    y_test,
    y_pred,
    labels=[0, 1],
    target_names=[
        "Slight (0)",
        "Severe/Fatal (1)"
    ],
    zero_division=0
)

print("\nCLASSIFICATION REPORT:")
print(class_report)

metrics_df.to_csv(
    "figures/decision_tree_metrics.csv",
    index=False
)

# ============================================================
# 10. CONFUSION MATRIX
# ============================================================

cm = confusion_matrix(
    y_test,
    y_pred,
    labels=[0, 1]
)

plt.figure(figsize=(7, 5))

sns.heatmap(
    cm,
    annot=True,
    fmt="d",
    cmap="Blues",
    xticklabels=[
        "Slight",
        "Severe/Fatal"
    ],
    yticklabels=[
        "Slight",
        "Severe/Fatal"
    ]
)

plt.title("Decision Tree - Confusion Matrix")
plt.xlabel("Predicted Class")
plt.ylabel("Actual Class")

plt.tight_layout()

plt.savefig(
    "figures/confusion_matrix.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()
plt.close()

# ============================================================
# 11. FEATURE IMPORTANCE
# ============================================================

fitted_preprocessor = final_dt.named_steps[
    "preprocessor"
]

tree_model = final_dt.named_steps[
    "classifier"
]

feature_names = fitted_preprocessor.get_feature_names_out()

importances = pd.DataFrame({

    "Feature": feature_names,

    "Importance": tree_model.feature_importances_

}).sort_values(
    "Importance",
    ascending=False
)

top_10 = importances.head(10)

print("\nTOP 10 IMPORTANT FEATURES:")
print(top_10.to_string(index=False))

importances.to_csv(
    "figures/feature_importance.csv",
    index=False
)

plt.figure(figsize=(9, 6))

sns.barplot(
    data=top_10.sort_values("Importance"),
    x="Importance",
    y="Feature"
)

plt.title("Top 10 Most Important Features")
plt.xlabel("Feature Importance")
plt.ylabel("Feature")

plt.tight_layout()

plt.savefig(
    "figures/feature_importance.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()
plt.close()

# ============================================================
# 12. DECISION TREE VISUALIZATION
# ============================================================

plt.figure(figsize=(24, 12))

plot_tree(
    tree_model,
    feature_names=feature_names,
    class_names=[
        "Slight",
        "Severe/Fatal"
    ],
    filled=True,
    rounded=True,
    fontsize=7,
    max_depth=3
)

plt.title(
    "Decision Tree Visualization - First 3 Levels"
)

plt.tight_layout()

plt.savefig(
    "figures/decision_tree_plot.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()
plt.close()

# ============================================================
# 13. SAVE SUMMARY TABLE
# ============================================================

summary = pd.DataFrame([{

    "Dataset": file_path.name,

    "Dataset_Rows": len(df),

    "Number_of_Features": X_raw.shape[1],

    "Best_Max_Depth": best_depth,

    "Accuracy": metrics["Accuracy"],

    "Precision": metrics["Precision"],

    "Recall": metrics["Recall"],

    "F1_Score": metrics["F1-Score"]

}])

summary.to_csv(
    "figures/decision_tree_summary.csv",
    index=False
)

# ============================================================
# 14. GENERATE MARKDOWN EXPLANATIONS
# ============================================================

markdown_text = f"""
