import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeClassifier, plot_tree
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix,
    classification_report
)

# 1. إعدادات البيئة وتثبيت العشوائية
RANDOM_STATE = 42
np.random.seed(RANDOM_STATE)

USE_CLEAN_DATA = False
CLEAN_PATH = "../data/clean/accidents_clean.csv"
RAW_PATH = "../data/raw/dft-road-casualty-statistics-collision-2025.csv"

# تعديل المسار تلقائياً إذا كنا نعمل عبر Google Colab
if os.path.exists('/kaggle/input') or 'colab' in str(get_ipython() if 'get_ipython' in globals() else ''):
    # مسار بديل لو كنت في كولاب وتحتاج رفع الملف أو جلبه من المستودع
    pass

# 2. تحميل البيانات
if USE_CLEAN_DATA and os.path.exists(CLEAN_PATH):
    df = pd.read_csv(CLEAN_PATH)
    print("تم تحميل البيانات النظيفة:", df.shape)
else:
    try:
        raw_df = pd.read_csv(RAW_PATH, low_memory=False)
    except FileNotFoundError:
        # مسار احتياطي للتحميل المباشر من جيت هاب إذا كنت على كولاب
        RAW_PATH = "https://raw.githubusercontent.com/oSaio/traffic-accident-patterns/main/data/raw/dft-road-casualty-statistics-collision-2025.csv"
        raw_df = pd.read_csv(RAW_PATH, low_memory=False)
        
    raw_df['hour'] = pd.to_datetime(raw_df['time'], format='%H:%M', errors='coerce').dt.hour
    raw_df['month'] = pd.to_datetime(raw_df['date'], format='%d/%m/%Y', errors='coerce').dt.month
    
    sev_map = {1: 'Fatal', 2: 'Serious', 3: 'Slight'}
    raw_df['accident_severity'] = raw_df['accident_severity'].map(sev_map)
    
    contract_cols = [
        'accident_index', 'latitude', 'longitude', 'hour', 'day_of_week', 'month',
        'speed_limit', 'road_type', 'light_conditions', 'weather_conditions',
        'road_surface_conditions', 'urban_or_rural_area', 'number_of_vehicles',
        'number_of_casualties', 'accident_severity'
    ]
    df = raw_df[contract_cols].rename(columns={'day_of_week': 'weekday'})
    df = df.replace(-1, np.nan).dropna()
    print("تم تحميل البيانات بنجاح:", df.shape)

# 3. تجهيز الهدف الثنائي ومنع تسريب البيانات
df['target_severe'] = df['accident_severity'].apply(
    lambda x: 1 if x in ['Fatal', 'Serious'] else 0
)

print("\nتوزيع الفئات:")
print(df['target_severe'].value_counts(normalize=True).round(4) * 100)

drop_cols = ['accident_index', 'accident_severity', 'number_of_casualties', 'target_severe']
X_raw = df.drop(columns=drop_cols)
y = df['target_severe']

# 4. ترميز المتغيرات النصية (One-Hot Encoding)
categorical_cols = [
    'weekday', 'road_type', 'light_conditions',
    'weather_conditions', 'road_surface_conditions', 'urban_or_rural_area'
]
for col in categorical_cols:
    if col in X_raw.columns:
        X_raw[col] = X_raw[col].astype(str)

X = pd.get_dummies(X_raw, columns=categorical_cols, drop_first=True)
print("حجم مصفوفة المتغيرات النهائية:", X.shape)

# 5. تقسيم البيانات (80% تدريب / 20% اختبار مع Stratify)
X_train, X_test, y_train, y_test = train_test_split(
    X, y,
    test_size=0.20,
    stratify=y,
    random_state=RANDOM_STATE
)

# 6. ضبط وفحص عمق الشجرة (Hyperparameter Tuning)
depths = [2, 3, 4, 5, 6, 8, 10, 12, 15]
results = []

for d in depths:
    clf = DecisionTreeClassifier(
        max_depth=d,
        class_weight='balanced',
        random_state=RANDOM_STATE
    )
    clf.fit(X_train, y_train)
    
    train_pred = clf.predict(X_train)
    test_pred = clf.predict(X_test)
    
    results.append({
        'max_depth': d,
        'Train_F1': f1_score(y_train, train_pred),
        'Test_F1': f1_score(y_test, test_pred),
        'Test_Recall': recall_score(y_test, test_pred),
        'Test_Precision': precision_score(y_test, test_pred),
        'Test_Accuracy': accuracy_score(y_test, test_pred)
    })

tuning_df = pd.DataFrame(results)
print("\nنتائج تجربة الأعماق المختلفة:")
print(tuning_df.round(4).to_string(index=False))

best_depth = int(tuning_df.loc[tuning_df['Test_F1'].idxmax(), 'max_depth'])
print(f"\nالعمق الأفضل المختار بناءً على F1-Score: {best_depth}")

# 7. تدريب النموذج النهائي بالعمق الأفضل
final_dt = DecisionTreeClassifier(
    max_depth=best_depth,
    class_weight='balanced',
    random_state=RANDOM_STATE
)
final_dt.fit(X_train, y_train)
y_pred = final_dt.predict(X_test)

print("\n=== نتائج التقييم النهائي للنموذج ===")
print(f"Accuracy  : {accuracy_score(y_test, y_pred):.4f}")
print(f"Precision : {precision_score(y_test, y_pred):.4f}")
print(f"Recall    : {recall_score(y_test, y_pred):.4f}")
print(f"F1-Score  : {f1_score(y_test, y_pred):.4f}\n")
print(classification_report(y_test, y_pred, target_names=['Slight (0)', 'Severe (1)']))

# 8. الرسوم البيانية (مصفوفة الارتباك وأهمية المتغيرات)
plt.figure(figsize=(14, 5))

# أ. مصفوفة الارتباك
plt.subplot(1, 2, 1)
cm = confusion_matrix(y_test, y_pred)
sns.heatmap(
    cm, annot=True, fmt='d', cmap='Blues',
    xticklabels=['Predicted Slight', 'Predicted Severe'],
    yticklabels=['Actual Slight', 'Actual Severe']
)
plt.title(f'Confusion Matrix (max_depth={best_depth})')
plt.ylabel('Actual')
plt.xlabel('Predicted')

# ب. أهم 10 متغيرات تأثيراً
plt.subplot(1, 2, 2)
importances = pd.Series(final_dt.feature_importances_, index=X.columns)
top_10 = importances.sort_values(ascending=False).head(10)
top_10.sort_values().plot(kind='barh', color='teal')
plt.title('Top 10 Most Important Features')
plt.xlabel('Importance')

plt.tight_layout()
plt.show()
