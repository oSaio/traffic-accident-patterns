    f.write(markdown_text)

# ============================================================
# 15. GENERATE TWO-PAGE PDF REPORT
# ============================================================

from reportlab.lib import colors
from reportlab.lib.pagesizes import A4
from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle
from reportlab.lib.units import cm

from reportlab.platypus import (
    SimpleDocTemplate,
    Paragraph,
    Spacer,
    Table,
    TableStyle,
    Image as RLImage,
    PageBreak
)

pdf_path = "report/decision_tree_report.pdf"

doc = SimpleDocTemplate(
    pdf_path,
    pagesize=A4,
    rightMargin=1.5 * cm,
    leftMargin=1.5 * cm,
    topMargin=1.2 * cm,
    bottomMargin=1.2 * cm
)

styles = getSampleStyleSheet()

styles.add(
    ParagraphStyle(
        name="ReportSmall",
        parent=styles["BodyText"],
        fontSize=8.5,
        leading=11
    )
)

story = []

# PAGE 1

story.append(
    Paragraph(
        "TRAFFIC ACCIDENT PATTERNS",
        styles["Title"]
    )
)

story.append(
    Paragraph(
        "Member 5 - Decision Tree Classification Model",
        styles["Heading2"]
    )
)

story.append(Spacer(1, 8))

story.append(
    Paragraph(
        "1. Methodology",
        styles["Heading2"]
    )
)

story.append(
    Paragraph(
        f"""
        This project applies a Decision Tree Classifier to the
        team's cleaned 2025 traffic accident dataset.
        The objective is to classify accidents into Slight (0)
        and Severe/Fatal (1) categories. The dataset contains
        {len(df)} usable records and {X_raw.shape[1]} input features.
        """,
        styles["ReportSmall"]
    )
)

story.append(Spacer(1, 6))

story.append(
    Paragraph(
        """
        Missing numerical values were replaced using median
        imputation, while categorical values were imputed using
        the most frequent value and encoded using One-Hot Encoding.
        The data was divided into 80% training and 20% testing.
        Hyperparameter tuning was conducted using a separate
        validation set.
        """,
        styles["ReportSmall"]
    )
)

story.append(Spacer(1, 8))

story.append(
    Paragraph(
        "2. Model Results",
        styles["Heading2"]
    )
)

table_data = [
    ["Metric", "Score"]
]

for _, row in metrics_df.iterrows():

    table_data.append([
        str(row["Metric"]),
        f"{row['Score']:.4f}"
    ])

metrics_table = Table(
    table_data,
    colWidths=[7 * cm, 4 * cm]
)

metrics_table.setStyle(
    TableStyle([
        (
            "BACKGROUND",
            (0, 0),
            (-1, 0),
            colors.HexColor("#DCE6F1")
        ),
        (
            "GRID",
            (0, 0),
            (-1, -1),
            0.5,
            colors.grey
        ),
        (
            "PADDING",
            (0, 0),
            (-1, -1),
            5
        ),
        (
            "ALIGN",
            (1, 1),
            (1, -1),
            "CENTER"
        )
    ])
)

story.append(metrics_table)

story.append(Spacer(1, 6))

story.append(
    Paragraph(
        "Confusion Matrix",
        styles["Heading3"]
    )
)

story.append(
    RLImage(
        "figures/confusion_matrix.png",
        width=8 * cm,
        height=4.5 * cm
    )
)

# PAGE 2

story.append(PageBreak())

story.append(
    Paragraph(
        "3. Feature Importance and Interpretation",
        styles["Heading2"]
    )
)

story.append(
    Paragraph(
        """
        Feature importance measures the contribution of each
        variable to the splitting decisions made by the trained
        Decision Tree. The chart displays the ten most important
        features identified by the model.
        """,
        styles["ReportSmall"]
    )
)

story.append(Spacer(1, 6))

story.append(
    RLImage(
        "figures/feature_importance.png",
        width=14 * cm,
        height=8.5 * cm
    )
)

story.append(Spacer(1, 6))

story.append(
    Paragraph(
        """
        Accuracy measures overall prediction correctness.
        Precision measures the reliability of severe predictions.
        Recall measures how many actual severe accidents were
        identified. F1-score balances precision and recall.
        The confusion matrix provides further information about
        correct and incorrect classifications.
        """,
        styles["ReportSmall"]
    )
)

story.append(Spacer(1, 8))

story.append(
    Paragraph(
        "4. Limitations",
        styles["Heading2"]
    )
)

story.append(
    Paragraph(
        """
        Decision Trees may overfit the training data, especially
        when the tree becomes too complex. Their performance
        also depends on data quality, class distribution and
        the selected features. Feature importance does not prove
        causation. Therefore, the model should be considered a
        predictive tool rather than proof of accident causes.
        """,
        styles["ReportSmall"]
    )
)

story.append(Spacer(1, 8))

story.append(
    Paragraph(
        f"""
        Selected Maximum Depth: {best_depth}<br/>
        Test F1-Score: {metrics['F1-Score']:.4f}
        """,
        styles["ReportSmall"]
    )
)

doc.build(story)

