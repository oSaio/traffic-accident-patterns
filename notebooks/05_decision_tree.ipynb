# ============================================================
# TRAFFIC ACCIDENT PATTERNS
# Member 5: Decision Tree Model
# ============================================================

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from pathlib import Path

from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeClassifier
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix,
    classification_report
)

# ============================================================
# 1. SETTINGS
# ============================================================

RANDOM_STATE = 42
np.random.seed(RANDOM_STATE)

# ============================================================
# 2. LOAD CLEAN DATASET
# ============================================================

possible_paths = [
    Path("data/clean/accidents_clean.csv"),
    Path("../data/clean/accidents_clean.csv")
]

DATA_PATH = None

for path in possible_paths:
    if path.exists():
        DATA_PATH = path
        break

if DATA_PATH is None:
    raise FileNotFoundError(
        "Dataset not found. Please check that "
        "accidents_clean.csv is inside data/clean/"
    )

df = pd.read_csv(
    DATA_PATH,
    dtype={"accident_index": str}
)

print("Data Shape:", df.shape)
print("Missing Values:", df.isna().sum().sum())

# ============================================================
# 3. CREATE BINARY TARGET
# ============================================================

# 1 = Fatal or Serious
# 0 = Slight

df["target_severe"] = df["accident_severity"].isin(
    ["Fatal", "Serious"]
).astype(int)

print("\nClass Distribution (%):")
print(
    (df["target_severe"].value_counts(normalize=True) * 100)
    .round(2)
)

# ============================================================
# 4. PREPARE FEATURES AND TARGET
# ============================================================

drop_cols = [
    "accident_index",
    "accident_severity",
    "number_of_casualties",
    "target_severe"
]

X_raw = df.drop(columns=drop_cols)
y = df["target_severe"]

# ============================================================
# 5. ONE-HOT ENCODING
# ============================================================

categorical_cols = [
    "weekday",
    "road_type",
    "light_conditions",
    "weather_conditions",
    "road_surface_conditions",
    "urban_or_rural_area"
]

X = pd.get_dummies(
    X_raw,
    columns=categorical_cols,
    drop_first=True
)

print("\nFinal Features Shape:", X.shape)

# ============================================================
# 6. TRAIN-TEST SPLIT
# ============================================================

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    stratify=y,
    random_state=RANDOM_STATE
)

# ============================================================
# 7. VALIDATION SPLIT
# ============================================================

X_tr, X_val, y_tr, y_val = train_test_split(
    X_train,
    y_train,
    test_size=0.25,
    stratify=y_train,
    random_state=RANDOM_STATE
)

# ============================================================
# 8. HYPERPARAMETER TUNING
# ============================================================

depths = [2, 3, 4, 5, 6, 8, 10]
results = []

for d in depths:

    clf = DecisionTreeClassifier(
        max_depth=d,
        class_weight="balanced",
        random_state=RANDOM_STATE
    )

    clf.fit(X_tr, y_tr)

    val_pred = clf.predict(X_val)

    results.append({
        "max_depth": d,
        "Train_F1": f1_score(
            y_tr,
            clf.predict(X_tr),
            zero_division=0
        ),
        "Val_F1": f1_score(
            y_val,
            val_pred,
            zero_division=0
        ),
        "Val_Recall": recall_score(
            y_val,
            val_pred,
            zero_division=0
        ),
        "Val_Precision": precision_score(
            y_val,
            val_pred,
            zero_division=0
        )
    })

tuning_df = pd.DataFrame(results)

print("\nTuning Results:")
print(tuning_df.round(4).to_string(index=False))

best_depth = int(
    tuning_df.loc[
        tuning_df["Val_F1"].idxmax(),
        "max_depth"
    ]
)

print("\nBest Depth Selected:", best_depth)

# ============================================================
# 9. TRAIN VS VALIDATION F1 PLOT
# ============================================================

plt.figure(figsize=(7, 4))

plt.plot(
    tuning_df["max_depth"],
    tuning_df["Train_F1"],
    marker="o",
    label="Train F1"
)

plt.plot(
    tuning_df["max_depth"],
    tuning_df["Val_F1"],
    marker="o",
    label="Validation F1"
)

plt.xlabel("Maximum Tree Depth")
plt.ylabel("F1 Score")
plt.title("F1 Score by Tree Depth")
plt.legend()
plt.tight_layout()
plt.show()

# ============================================================
# 10. TRAIN FINAL MODEL
# ============================================================

final_dt = DecisionTreeClassifier(
    max_depth=best_depth,
    class_weight="balanced",
    random_state=RANDOM_STATE
)

final_dt.fit(X_train, y_train)

y_pred = final_dt.predict(X_test)

# ============================================================
# 11. MODEL EVALUATION
# ============================================================

baseline_acc = 1 - y_test.mean()

accuracy = accuracy_score(y_test, y_pred)

precision = precision_score(
    y_test,
    y_pred,
    zero_division=0
)

recall = recall_score(
    y_test,
    y_pred,
    zero_division=0
)

f1 = f1_score(
    y_test,
    y_pred,
    zero_division=0
)

print("\nFINAL MODEL EVALUATION")

print("Best Depth:", best_depth)
print(f"Baseline Accuracy: {baseline_acc:.4f}")
print(f"Accuracy: {accuracy:.4f}")
print(f"Precision: {precision:.4f}")
print(f"Recall: {recall:.4f}")
print(f"F1-Score: {f1:.4f}")

print(
    classification_report(
        y_test,
        y_pred,
        labels=[0, 1],
        target_names=["Slight (0)", "Severe (1)"],
        zero_division=0
    )
)

# ============================================================
# 12. CONFUSION MATRIX
# ============================================================

cm = confusion_matrix(
    y_test,
    y_pred,
    labels=[0, 1]
)

plt.figure(figsize=(7, 5))

sns.heatmap(
    cm,
    annot=True,
    fmt="d",
    cmap="Blues",
    xticklabels=[
        "Predicted Slight",
        "Predicted Severe"
    ],
    yticklabels=[
        "Actual Slight",
        "Actual Severe"
    ]
)

plt.title(f"Confusion Matrix (Depth={best_depth})")
plt.ylabel("Actual")
plt.xlabel("Predicted")
plt.tight_layout()
plt.show()

# ============================================================
# 13. FEATURE IMPORTANCE
# ============================================================

importances = pd.Series(
    final_dt.feature_importances_,
    index=X.columns
)

top_10 = importances.sort_values(
    ascending=False
).head(10)

print("\nTop 10 Important Features:")
print(top_10.round(4).to_string())

plt.figure(figsize=(8, 5))

top_10.sort_values().plot(
    kind="barh",
    color="teal"
)

plt.title("Top 10 Most Important Features")
plt.xlabel("Importance")
plt.tight_layout()
plt.show()

# ============================================================
# 14. EXAMPLE PREDICTION
# ============================================================

sample_accident = X_test.iloc[[0]]

pred_class = final_dt.predict(sample_accident)[0]

pred_prob = final_dt.predict_proba(
    sample_accident
)[0][1]

print("\nSample Prediction:")

print(
    f"{'Severe (1)' if pred_class == 1 else 'Slight (0)'} "
    f"(Probability of Severe: {pred_prob:.2%})"
)

# ============================================================
# 15. COMPARE WITH AND WITHOUT LOCATION
# ============================================================

X_without_location = X.drop(
    columns=["latitude", "longitude"]
)

X_train_no, X_test_no, y_train_no, y_test_no = (
    train_test_split(
        X_without_location,
        y,
        test_size=0.20,
        stratify=y,
        random_state=RANDOM_STATE
    )
)

model_no_location = DecisionTreeClassifier(
    max_depth=best_depth,
    class_weight="balanced",
    random_state=RANDOM_STATE
)

model_no_location.fit(
    X_train_no,
    y_train_no
)

pred_no_location = model_no_location.predict(
    X_test_no
)

f1_with_location = f1_score(
    y_test,
    y_pred,
    zero_division=0
)

f1_without_location = f1_score(
    y_test_no,
    pred_no_location,
    zero_division=0
)

print("\nLOCATION COMPARISON")

print(
    f"F1 WITH location: {f1_with_location:.4f}"
)

print(
    f"F1 WITHOUT location: {f1_without_location:.4f}"
)

# ============================================================
# 16. LOCATION COMPARISON TABLE
# ============================================================

comparison_df = pd.DataFrame({
    "Metric": [
        "Accuracy",
        "Precision",
        "Recall",
        "F1-Score"
    ],

    "With Location": [
        accuracy_score(y_test, y_pred),
        precision_score(y_test, y_pred, zero_division=0),
        recall_score(y_test, y_pred, zero_division=0),
        f1_with_location
    ],

    "Without Location": [
        accuracy_score(y_test_no, pred_no_location),
        precision_score(
            y_test_no,
            pred_no_location,
            zero_division=0
        ),
        recall_score(
            y_test_no,
            pred_no_location,
            zero_division=0
        ),
        f1_without_location
    ]
})

print("\nLOCATION COMPARISON TABLE")
print(comparison_df.round(4).to_string(index=False))

# ============================================================
# 17. LOCATION COMPARISON PLOT
# ============================================================

comparison_df.set_index("Metric").plot(
    kind="bar",
    figsize=(9, 5)
)

plt.title("Decision Tree: With vs Without Location")
plt.ylabel("Score")
plt.ylim(0, 1)
plt.xticks(rotation=0)
plt.tight_layout()
plt.show()

# ============================================================
# 18. AUTOMATIC WRITTEN ANALYSIS
# ============================================================

print("\n" + "=" * 55)
print("WRITTEN ANALYSIS AND CONCLUSION")
print("=" * 55)

print(f"""
MODEL PERFORMANCE:

The Decision Tree model was trained to classify traffic
accidents into Slight and Severe categories.

The selected maximum tree depth was {best_depth}.

The evaluation results were:

Accuracy: {accuracy:.4f}
Precision: {precision:.4f}
Recall: {recall:.4f}
F1-Score: {f1:.4f}


LOCATION FEATURES COMPARISON:

The model was evaluated using two feature sets:

1. With latitude and longitude.
2. Without latitude and longitude.

F1-Score with location: {f1_with_location:.4f}
F1-Score without location: {f1_without_location:.4f}
""")

if f1_with_location > f1_without_location:
    print(
        "The model with location features achieved "
        "a higher F1-Score in this experiment."
    )

elif f1_without_location > f1_with_location:
    print(
        "The model without location features achieved "
        "a higher F1-Score in this experiment."
    )

else:
    print(
        "Both models achieved the same F1-Score "
        "in this experiment."
    )

print("""
CONCLUSION:

The Decision Tree algorithm provides a classification
approach for identifying severe traffic accidents.

Feature importance helps identify the input variables
that contribute most to the model predictions.

The location comparison evaluates the contribution
of latitude and longitude to model performance.

These results describe this dataset and experiment.
They do not prove causal relationships.
""")

# ============================================================
# 19. FINAL STATUS
# ============================================================

print("\nDECISION TREE MODEL COMPLETED SUCCESSFULLY")
