# ============================================================
# DATA MINING PROJECT
# Traffic Accident Patterns
# Member 5: Decision Tree Model
# ============================================================

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from pathlib import Path

from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeClassifier
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix,
    classification_report
)

# ============================================================
# 1. SETTINGS
# ============================================================

RANDOM_STATE = 42
TEST_SIZE = 0.20
VALIDATION_SIZE = 0.25

np.random.seed(RANDOM_STATE)

# ============================================================
# 2. LOAD DATASET
# ============================================================

possible_paths = [
    Path("data/clean/accidents_clean.csv"),
    Path("../data/clean/accidents_clean.csv"),
    Path("/content/accidents_clean.csv")
]

# Also check paths relative to this Python file
try:
    script_folder = Path(__file__).resolve().parent
    possible_paths.extend([
        script_folder / "../data/clean/accidents_clean.csv",
        script_folder / "data/clean/accidents_clean.csv"
    ])
except NameError:
    pass

DATA_PATH = next(
    (p.resolve() for p in possible_paths if p.exists()),
    None
)

if DATA_PATH is None:
    raise FileNotFoundError(
        "Dataset not found. Make sure accidents_clean.csv "
        "is inside data/clean/"
    )

df = pd.read_csv(
    DATA_PATH,
    dtype={"accident_index": str}
)

print("=" * 60)
print("TRAFFIC ACCIDENT DATASET")
print("=" * 60)

print("Dataset path:", DATA_PATH)
print("Dataset shape:", df.shape)
print("Missing values:", df.isnull().sum().sum())

# ============================================================
# 3. CHECK REQUIRED COLUMNS
# ============================================================

required_columns = [
    "accident_index",
    "latitude",
    "longitude",
    "hour",
    "weekday",
    "month",
    "speed_limit",
    "road_type",
    "light_conditions",
    "weather_conditions",
    "road_surface_conditions",
    "urban_or_rural_area",
    "number_of_vehicles",
    "number_of_casualties",
    "accident_severity"
]

missing_columns = [
    col for col in required_columns if col not in df.columns
]

if missing_columns:
    raise ValueError(
        f"Missing required columns: {missing_columns}"
    )

# ============================================================
# 4. CREATE TARGET VARIABLE
# ============================================================

# 1 = Fatal or Serious
# 0 = Slight

df["target_severe"] = (
    df["accident_severity"]
    .isin(["Fatal", "Serious"])
    .astype(int)
)

print("\nClass Distribution:")
print(
    df["target_severe"]
    .value_counts()
    .rename(index={0: "Slight", 1: "Severe"})
)

print("\nClass Distribution Percentage:")
print(
    (df["target_severe"].value_counts(normalize=True) * 100)
    .round(2)
)

# ============================================================
# 5. PREPARE FEATURES AND TARGET
# ============================================================

# Remove columns that should not be used as predictors.
# number_of_casualties is excluded to avoid target leakage.

drop_columns = [
    "accident_index",
    "accident_severity",
    "number_of_casualties",
    "target_severe"
]

X_raw = df.drop(columns=drop_columns)
y = df["target_severe"]

# ============================================================
# 6. ONE-HOT ENCODING
# ============================================================

categorical_columns = [
    "weekday",
    "road_type",
    "light_conditions",
    "weather_conditions",
    "road_surface_conditions",
    "urban_or_rural_area"
]

X = pd.get_dummies(
    X_raw,
    columns=categorical_columns,
    drop_first=True
)

# Ensure all features are numeric
X = X.astype(float)

print("\nPrepared Features Shape:", X.shape)

# ============================================================
# 7. TRAIN-TEST SPLIT
# ============================================================

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=TEST_SIZE,
    stratify=y,
    random_state=RANDOM_STATE
)

# ============================================================
# 8. TRAIN-VALIDATION SPLIT
# ============================================================

X_train_part, X_val, y_train_part, y_val = train_test_split(
    X_train,
    y_train,
    test_size=VALIDATION_SIZE,
    stratify=y_train,
    random_state=RANDOM_STATE
)

# ============================================================
# 9. HYPERPARAMETER TUNING
# ============================================================

depths = [2, 3, 4, 5, 6, 8, 10]

tuning_results = []

for depth in depths:

    model = DecisionTreeClassifier(
        max_depth=depth,
        class_weight="balanced",
        random_state=RANDOM_STATE
    )

    model.fit(X_train_part, y_train_part)

    train_prediction = model.predict(X_train_part)
    val_prediction = model.predict(X_val)

    tuning_results.append({
        "Max Depth": depth,
        "Training F1": f1_score(
            y_train_part,
            train_prediction,
            zero_division=0
        ),
        "Validation F1": f1_score(
            y_val,
            val_prediction,
            zero_division=0
        ),
        "Validation Recall": recall_score(
            y_val,
            val_prediction,
            zero_division=0
        ),
        "Validation Precision": precision_score(
            y_val,
            val_prediction,
            zero_division=0
        )
    })

tuning_df = pd.DataFrame(tuning_results)

print("\nHYPERPARAMETER TUNING RESULTS")
print(tuning_df.round(4).to_string(index=False))

best_depth = int(
    tuning_df.loc[
        tuning_df["Validation F1"].idxmax(),
        "Max Depth"
    ]
)

print("\nBest Tree Depth:", best_depth)

# ============================================================
# 10. TRAINING VS VALIDATION PLOT
# ============================================================

plt.figure(figsize=(8, 5))

plt.plot(
    tuning_df["Max Depth"],
    tuning_df["Training F1"],
    marker="o",
    label="Training F1"
)

plt.plot(
    tuning_df["Max Depth"],
    tuning_df["Validation F1"],
    marker="o",
    label="Validation F1"
)

plt.xlabel("Maximum Tree Depth")
plt.ylabel("F1 Score")
plt.title("Decision Tree: Training vs Validation F1")
plt.legend()
plt.grid(True)
plt.tight_layout()
plt.show()

# ============================================================
# 11. TRAIN FINAL DECISION TREE MODEL
# ============================================================

final_model = DecisionTreeClassifier(
    max_depth=best_depth,
    class_weight="balanced",
    random_state=RANDOM_STATE
)

final_model.fit(X_train, y_train)

y_pred = final_model.predict(X_test)

# ============================================================
# 12. MODEL EVALUATION
# ============================================================

accuracy = accuracy_score(y_test, y_pred)

precision = precision_score(
    y_test, y_pred, zero_division=0
)

recall = recall_score(
    y_test, y_pred, zero_division=0
)

f1 = f1_score(
    y_test, y_pred, zero_division=0
)

baseline_accuracy = (y_test == 0).mean()

print("\n" + "=" * 60)
print("FINAL DECISION TREE EVALUATION")
print("=" * 60)

print("Best Tree Depth:", best_depth)
print(f"Baseline Accuracy: {baseline_accuracy:.4f}")
print(f"Accuracy: {accuracy:.4f}")
print(f"Precision: {precision:.4f}")
print(f"Recall: {recall:.4f}")
print(f"F1-Score: {f1:.4f}")

print("\nClassification Report:")

print(
    classification_report(
        y_test,
        y_pred,
        labels=[0, 1],
        target_names=["Slight (0)", "Severe (1)"],
        zero_division=0
    )
)

# ============================================================
# 13. CONFUSION MATRIX
# ============================================================

cm = confusion_matrix(
    y_test,
    y_pred,
    labels=[0, 1]
)

plt.figure(figsize=(7, 5))

sns.heatmap(
    cm,
    annot=True,
    fmt="d",
    cmap="Blues",
    xticklabels=["Predicted Slight", "Predicted Severe"],
    yticklabels=["Actual Slight", "Actual Severe"]
)

plt.title("Decision Tree Confusion Matrix")
plt.xlabel("Predicted Class")
plt.ylabel("Actual Class")
plt.tight_layout()
plt.show()

# ============================================================
# 14. FEATURE IMPORTANCE
# ============================================================

feature_importance = pd.Series(
    final_model.feature_importances_,
    index=X.columns
)

top_features = (
    feature_importance
    .sort_values(ascending=False)
    .head(10)
)

print("\nTOP 10 IMPORTANT FEATURES")
print(top_features.round(4).to_string())

plt.figure(figsize=(9, 6))

top_features.sort_values().plot(
    kind="barh",
    color="teal"
)

plt.title("Top 10 Important Features")
plt.xlabel("Feature Importance")
plt.ylabel("Features")
plt.tight_layout()
plt.show()

# ============================================================
# 15. SAMPLE PREDICTION
# ============================================================

sample = X_test.iloc[[0]]

sample_prediction = final_model.predict(sample)[0]

sample_probability = (
    final_model.predict_proba(sample)[0][1]
)

print("\nSAMPLE ACCIDENT PREDICTION")

if sample_prediction == 1:
    print("Predicted Class: Severe (Fatal or Serious)")
else:
    print("Predicted Class: Slight")

print(
    f"Probability of Severe Accident: "
    f"{sample_probability:.2%}"
)

# ============================================================
# 16. COMPARE MODEL WITH AND WITHOUT LOCATION
# ============================================================

location_columns = ["latitude", "longitude"]

missing_location = [
    col for col in location_columns if col not in X.columns
]

if missing_location:
    raise ValueError(
        f"Location columns not found: {missing_location}"
    )

X_without_location = X.drop(
    columns=location_columns
)

# Use the same split settings for a fair comparison

X_train_no, X_test_no, y_train_no, y_test_no = train_test_split(
    X_without_location,
    y,
    test_size=TEST_SIZE,
    stratify=y,
    random_state=RANDOM_STATE
)

model_without_location = DecisionTreeClassifier(
    max_depth=best_depth,
    class_weight="balanced",
    random_state=RANDOM_STATE
)

model_without_location.fit(
    X_train_no,
    y_train_no
)

prediction_without_location = (
    model_without_location.predict(X_test_no)
)

# Calculate comparison metrics

f1_with_location = f1_score(
    y_test,
    y_pred,
    zero_division=0
)

f1_without_location = f1_score(
    y_test_no,
    prediction_without_location,
    zero_division=0
)

accuracy_with_location = accuracy_score(
    y_test,
    y_pred
)

accuracy_without_location = accuracy_score(
    y_test_no,
    prediction_without_location
)

recall_with_location = recall_score(
    y_test,
    y_pred,
    zero_division=0
)

recall_without_location = recall_score(
    y_test_no,
    prediction_without_location,
    zero_division=0
)

comparison_df = pd.DataFrame({
    "Metric": ["Accuracy", "Recall", "F1-Score"],
    "With Location": [
        accuracy_with_location,
        recall_with_location,
        f1_with_location
    ],
    "Without Location": [
        accuracy_without_location,
        recall_without_location,
        f1_without_location
    ]
})

print("\n" + "=" * 60)
print("LOCATION FEATURES COMPARISON")
print("=" * 60)

print(comparison_df.round(4).to_string(index=False))

# ============================================================
# 17. COMPARISON VISUALIZATION
# ============================================================

comparison_df.set_index("Metric").plot(
    kind="bar",
    figsize=(9, 5)
)

plt.title("Decision Tree: With vs Without Location")
plt.ylabel("Score")
plt.xlabel("Evaluation Metrics")
plt.ylim(0, 1)
plt.xticks(rotation=0)
plt.legend(title="Model")
plt.tight_layout()
plt.show()

# ============================================================
# 18. AUTOMATIC WRITTEN ANALYSIS
# ============================================================

print("\n" + "=" * 60)
print("WRITTEN RESULTS AND ANALYSIS")
print("=" * 60)

print(
    f"""
1. MODEL PERFORMANCE

The Decision Tree model was trained to classify traffic
accidents into two categories:
- Slight accidents.
- Severe accidents (Fatal or Serious).

The selected maximum tree depth was {best_depth}.

The model achieved:
- Accuracy: {accuracy:.4f}
- Precision: {precision:.4f}
- Recall: {recall:.4f}
- F1-Score: {f1:.4f}

2. LOCATION FEATURES COMPARISON

The model was evaluated using two feature sets:
- Model with latitude and longitude.
- Model without latitude and longitude.

F1-Score with location: {f1_with_location:.4f}
F1-Score without location: {f1_without_location:.4f}

Accuracy with location: {accuracy_with_location:.4f}
Accuracy without location: {accuracy_without_location:.4f}
"""
)

difference = f1_with_location - f1_without_location

if difference > 0.0001:
    print(
        "INTERPRETATION: The model with location features "
        "achieved a higher F1-Score in this experiment."
    )

elif difference < -0.0001:
    print(
        "INTERPRETATION: The model without location features "
        "achieved a higher F1-Score in this experiment."
    )

else:
    print(
        "INTERPRETATION: Both models achieved approximately "
        "the same F1-Score in this experiment."
    )

print(
    """
3. CONCLUSION

The Decision Tree algorithm provides a classification
approach for identifying severe traffic accidents.

Feature importance helps identify which input variables
contribute most to the model's predictions.

The location comparison helps evaluate whether latitude
and longitude improve the model's performance.

These results describe this dataset and experiment;
they do not establish causation or guarantee future outcomes.
"""
)

# ============================================================
# 19. FINAL STATUS
# ============================================================

print("\n" + "=" * 60)
print("DECISION TREE ANALYSIS COMPLETED SUCCESSFULLY")
print("=" * 60)
