# Decision Tree - Traffic Accident Severity Prediction
# Member 5
# =====================================================

# 1. Import Libraries
import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeClassifier
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix,
    classification_report
)

RANDOM_STATE = 42
np.random.seed(RANDOM_STATE)


# 2. Load Clean Dataset
df = pd.read_csv(
    '../data/clean/accidents_clean.csv',
    dtype={'accident_index': str}
)

print("Data Shape:", df.shape)
print("Missing Values:", df.isna().sum().sum())


# 3. Create Binary Target
# 1 = Fatal or Serious
# 0 = Slight

df['target_severe'] = df['accident_severity'].isin(
    ['Fatal', 'Serious']
).astype(int)

print("\nClass Distribution (%):")
print(
    (df['target_severe'].value_counts(normalize=True) * 100).round(2)
)


# 4. Prepare Features and Target
drop_cols = [
    'accident_index',
    'accident_severity',
    'number_of_casualties',
    'target_severe'
]

X_raw = df.drop(columns=drop_cols)
y = df['target_severe']


# 5. One-Hot Encoding
categorical_cols = [
    'weekday',
    'road_type',
    'light_conditions',
    'weather_conditions',
    'road_surface_conditions',
    'urban_or_rural_area'
]

X = pd.get_dummies(
    X_raw,
    columns=categorical_cols,
    drop_first=True
)

print("\nFinal Features Shape:", X.shape)


# 6. Train-Test Split (80% / 20%)
X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    stratify=y,
    random_state=RANDOM_STATE
)


# 7. Validation Split and Hyperparameter Tuning
X_tr, X_val, y_tr, y_val = train_test_split(
    X_train,
    y_train,
    test_size=0.25,
    stratify=y_train,
    random_state=RANDOM_STATE
)

depths = [2, 3, 4, 5, 6, 8, 10]
results = []

for d in depths:

    clf = DecisionTreeClassifier(
        max_depth=d,
        class_weight='balanced',
        random_state=RANDOM_STATE
    )

    clf.fit(X_tr, y_tr)

    val_pred = clf.predict(X_val)

    results.append({
        'max_depth': d,
        'Train_F1': f1_score(y_tr, clf.predict(X_tr)),
        'Val_F1': f1_score(y_val, val_pred),
        'Val_Recall': recall_score(y_val, val_pred),
        'Val_Precision': precision_score(y_val, val_pred)
    })

tuning_df = pd.DataFrame(results)

print("\nTuning Results:")
print(tuning_df.round(4).to_string(index=False))

best_depth = int(
    tuning_df.loc[
        tuning_df['Val_F1'].idxmax(),
        'max_depth'
    ]
)

print("\nBest Depth Selected:", best_depth)


# 8. Plot Train vs Validation F1
plt.figure(figsize=(7, 4))

plt.plot(
    tuning_df['max_depth'],
    tuning_df['Train_F1'],
    marker='o',
    label='Train F1'
)

plt.plot(
    tuning_df['max_depth'],
    tuning_df['Val_F1'],
    marker='o',
    label='Validation F1'
)

plt.xlabel('max_depth')
plt.ylabel('F1 Score')
plt.title('F1 Score by Tree Depth')
plt.legend()
plt.tight_layout()
plt.show()


# 9. Train Final Decision Tree Model
final_dt = DecisionTreeClassifier(
    max_depth=best_depth,
    class_weight='balanced',
    random_state=RANDOM_STATE
)

final_dt.fit(X_train, y_train)

y_pred = final_dt.predict(X_test)


# 10. Model Evaluation
baseline_acc = 1 - y_test.mean()

print("\n=== Final Model Evaluation ===")

print(f"Baseline Accuracy: {baseline_acc:.4f}")
print(f"Accuracy  : {accuracy_score(y_test, y_pred):.4f}")
print(f"Precision : {precision_score(y_test, y_pred):.4f}")
print(f"Recall    : {recall_score(y_test, y_pred):.4f}")
print(f"F1-Score  : {f1_score(y_test, y_pred):.4f}")

print("\nClassification Report:")

print(
    classification_report(
        y_test,
        y_pred,
        target_names=['Slight (0)', 'Severe (1)']
    )
)


# 11. Confusion Matrix
plt.figure(figsize=(7, 5))

cm = confusion_matrix(y_test, y_pred)

sns.heatmap(
    cm,
    annot=True,
    fmt='d',
    cmap='Blues',
    xticklabels=['Predicted Slight', 'Predicted Severe'],
    yticklabels=['Actual Slight', 'Actual Severe']
)

plt.title(f'Confusion Matrix (max_depth={best_depth})')
plt.ylabel('Actual')
plt.xlabel('Predicted')
plt.tight_layout()
plt.show()


# 12. Feature Importance
importances = pd.Series(
    final_dt.feature_importances_,
    index=X.columns
)

top_10 = importances.sort_values(
    ascending=False
).head(10)

plt.figure(figsize=(8, 5))

top_10.sort_values().plot(
    kind='barh',
    color='teal'
)

plt.title('Top 10 Most Important Features')
plt.xlabel('Importance')
plt.tight_layout()
plt.show()


# 13. Example Prediction
sample_accident = X_test.iloc[[0]]

pred_class = final_dt.predict(sample_accident)[0]

pred_prob = final_dt.predict_proba(sample_accident)[0][1]

print("\nSample Prediction:")

print(
    f"{'Severe (1)' if pred_class == 1 else 'Slight (0)'}"
    f" (Probability of Severe: {pred_prob:.2%})"
)
