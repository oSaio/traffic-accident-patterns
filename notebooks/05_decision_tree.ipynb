with open(
    REPORT_DIR / "markdown_explanations.md",
    "w",
    encoding="utf-8"
) as file:
    file.write(report_text)

# ============================================================
# 17. FINAL RESULTS
# ============================================================

print("\n======================================")
print("DECISION TREE MODEL COMPLETED")
print("======================================")

print(f"Accuracy:  {accuracy:.4f}")
print(f"Precision: {precision:.4f}")
print(f"Recall:    {recall:.4f}")
print(f"F1 Score:  {f1:.4f}")

print("\nGenerated folders:")
print("figures/")
print("report/")

print("\nGenerated figures:")
print("confusion_matrix.png")
print("feature_importance.png")
print("max_depth_comparison.png")
print("decision_tree.png")

print("\nGenerated reports:")
print("tuning_results.csv")
print("model_metrics.csv")
print("classification_report.txt")
print("feature_importance.csv")
print("predictions.csv")
print("markdown_explanations.md")

print("\nAll steps completed successfully.")
