import pandas as pd

# Official UK Government DfT Road Safety Data URL for 2022 Collisions
ALT_RAW_PATH = "https://data.dft.gov.uk/road-accidents-safety-data/dft-road-casualty-statistics-collision-2022.csv"

print("Loading official UK road safety 2022 data...")
try:
    alt_raw_df = pd.read_csv(ALT_RAW_PATH, low_memory=False)
    print("Alternative data loaded successfully!")
    print("Shape:", alt_raw_df.shape)
    display(alt_raw_df.head(3))
except Exception as e:
    print(f"An error occurred while loading alternative data: {e}")
